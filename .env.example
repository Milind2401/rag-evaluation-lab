# Azure OpenAI (required - no fallback defaults)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Azure OpenAI API version (optional, default: 2024-02-01)
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure OpenAI deployment names
# NOTE: these are your Azure *deployment* names, which may differ from model names.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- MISSING: required for Phase 2 (embedding model comparison) ---
# Set these to the actual deployment names in your Azure OpenAI resource.
AZURE_OPENAI_EMBEDDING_LARGE_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_ADA_DEPLOYMENT=text-embedding-ada-002

# Chat model (optional, default: gpt-4o)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Azure AI Search (required - no fallback defaults)
AZURE_AI_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_AI_SEARCH_API_KEY=your-search-admin-key

# Index name (optional, default: rag-evaluation-index)
AZURE_AI_SEARCH_INDEX_NAME=rag-evaluation-index
